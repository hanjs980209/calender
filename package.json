{
  "name": "desktop-calendar-widget",
  "version": "0.2.0",
  "private": true,
  "description": "Windows용 바탕화면 달력과 메모 위젯",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.58.2"
  },
  "build": {
    "appId": "com.calender.desktop",
    "productName": "하루 달력",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
